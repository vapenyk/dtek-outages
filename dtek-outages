#!/usr/bin/env python3
"""Run the tool straight from a checkout, without installing the package.

    ./dtek-outages
    ./dtek-outages --city 'м. Одеса' --street 'вул. Дерибасівська' --house 1
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from dtek_outages.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
